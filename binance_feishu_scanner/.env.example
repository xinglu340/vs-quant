# Binance public USDⓈ-M Futures API
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com

# Scanner
BASE_INTERVAL=30m
TOP_N=80
MIN_QUOTE_VOLUME=10000000
KLINE_LIMIT=300
MIN_SCORE=72
MAX_PUSH=12
MAX_WORKERS=8
REQUEST_TIMEOUT=10
COOLDOWN_MINUTES=90
SEND_EMPTY_REPORT=true

# Run at :01 and :31 so the previous 30m candle is fully closed.
SCHEDULE_MINUTES=1,31

# Feishu custom bot
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/REPLACE_ME
# Optional: fill only if you enabled "signature verification / security secret"
FEISHU_SECRET=

# Local state file for signal de-duplication
STATE_FILE=scanner_state.json
LOG_LEVEL=INFO
